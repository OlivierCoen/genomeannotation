/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/genomeannotation/'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true

process {

    withName: 'BRAKER3' {
        ext.args   = { [
            "--gm_max_intergenic 10000" // to make the test run faster; see https://github.com/Gaius-Augustus/BRAKER#data-description
        ].join(' ').trim() }
    }
    
    withName: 'EGGNOGMAPPER_EMAPPER' {
        ext.args = { [
            "--sensmode", "fast",
            "--dmnd_iterate", "no"
        ].join(' ').trim() }
    }
    
}