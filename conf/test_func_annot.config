/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 12,
        memory: '20.GB',
        time: '4.h'
    ]

    withName: 'EGGNOGMAPPER2_EMAPPER' {
        ext.args = { [
            "--sensmode", "fast",
            "--dmnd_iterate", "no"
        ].join(' ').trim() }
    }
}

params {

    input  = "tests/test_data/samplesheets/test_func_annot.yaml"
    skip_masking = true
    skip_structural_annotation = true
    skip_qc = true
    functional_annotators = ["eggnogmapper2", "interproscan6"]
    //functional_annotators = ["interproscan6"]

}
